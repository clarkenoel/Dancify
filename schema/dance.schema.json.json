{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dancify Dance",
  "type": "object",
  "required": ["version", "bpm", "beat_times", "duration", "moves"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "bpm": { "type": "number" },
    "beat_times": {
      "type": "array",
      "items": { "type": "number" }
    },
    "duration": { "type": "number" },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "keyframe_landmarks", "is_hold"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "keyframe_landmarks": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 33,
            "maxItems": 33
          },
          "is_hold": { "type": "boolean" }
        }
      }
    }
  }
}